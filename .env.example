# ScamCity optional LLM adapter (agents/llm-adapter.ts)
#
# Copy this file to `.env.local` and fill in your own key.
# The default demo is fully offline: keep LLM_ENABLED=false and the
# deterministic decision model is used. Never commit real keys.

# Set to true to let the optional adapter call the gateway.
LLM_ENABLED=false

# API key created in the activity console. Leave empty for offline runs.
OPENAI_API_KEY=

# OpenAI-compatible endpoint. The trailing /v1 is required.
# OpenAI Next Credits gateway: https://api.openai-next.com/v1
# Backup route if you see 524 / gateway timeouts: https://us.api.openai-next.com/v1
OPENAI_BASE_URL=https://api.openai-next.com/v1

# Any chat-completions model exposed by the gateway, e.g.
# deepseek-v4-1-flash-260910, gpt-5.6-sol, claude-sonnet-4-5-20250929, glm-5
OPENAI_MODEL=deepseek-v4-1-flash-260910

# Gateway latency + reasoning models need more headroom than a direct call.
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1200
